# Lockstep credentials template.
#
#   copy .env.example .env.local     and fill in only the section you need
#
# .env.local is gitignored (see .gitignore). Nothing in it is ever printed by our
# tooling; live-dispatch reports a count of variables loaded, never names or values.
#
# Prefer this file over command-line arguments. Arguments land in shell history and are
# visible in the process list to any other user on the machine; a gitignored file is not.
#
# The three sections are independent. Section 1 alone is enough to run the kill gate.


# =============================================================================
# 1. MODEL CREDENTIAL  — required to run scripts/live-dispatch.mjs
# =============================================================================
# This is the only section needed to prove the product works. The harness starts its
# own chain, deploys its own contracts, and uses Anvil's public test keys, so it needs
# no wallet and no deployed address from you.
#
# Pick ONE provider.

# --- Option A: AWS Bedrock -----------------------------------------------------
# OpenClaw resolves this as provider "amazon-bedrock" with auth mode "aws-sdk",
# triggered by the presence of AWS_* variables.
#
# Scope the IAM user or role to bedrock:InvokeModel only. Nothing here needs more.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region matters: Bedrock model ids are region-scoped and availability differs per
# region, so this cannot be defaulted.
AWS_REGION=us-east-1
#
# Instead of a key pair you may use either of these:
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=
#
# You must also pass a model id on the command line, because which models exist depends
# on your account and region. List the ones you can see:
#   aws bedrock list-foundation-models --region us-east-1 --by-provider anthropic \
#     --query "modelSummaries[].modelId" --output text
#
# That list is misleading on its own. It reports models that exist, not models you can
# call, and two separate things will reject you:
#
#   1. Bare model ids do not work. Current Claude models are only invocable through a
#      cross-region inference profile, which is the model id with a geography prefix
#      (us. eu. apac.). The bare id fails with ValidationException.
#   2. Older models are refused as Legacy if the account has not called them recently.
#
# So verify by invoking, not by reading the list:
#   aws bedrock-runtime converse --region us-east-1 \
#     --model-id us.anthropic.claude-sonnet-4-5-20250929-v1:0 \
#     --messages '[{"role":"user","content":[{"text":"hi"}]}]' \
#     --inference-config maxTokens=16
#
# Confirmed working on this account (region us-east-1):
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
#   node scripts/live-dispatch.mjs --provider bedrock \
#     --model amazon-bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Option B: Anthropic or OpenAI direct --------------------------------------
# Passed with --key instead, or set here and read from the environment.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=


# =============================================================================
# 2. MONAD TESTNET  — required only to deploy and measure real gas
# =============================================================================
# Every gas figure quoted so far was measured on a local EVM. Testnet numbers are the
# ones that belong in the submission.
#
# You do not need to hand over a private key. Ask for a fresh keypair to be generated
# locally, fund the address it prints from https://faucet.monad.xyz, and the key never
# leaves this machine.

CHAIN_ID=10143
# testnet-rpc, not rpc.testnet. The transposed hostname does not resolve -- it was the default in ten
# places in this repo and every one of them failed with ENOTFOUND. This matches viem's monadTestnet.
RPC_URL=https://testnet-rpc.monad.xyz

# ---------------------------------------------------------------------------
# Live Monad testnet deployment. Public values, safe to commit.
# ---------------------------------------------------------------------------
# Deployed and verified by reading state back off chain. Immutables, guard wiring and the ERC-7201
# storage slot all checked against the source. See README for the transaction hashes.
#
#   PinRegistry     0xe784a386591cFcE683fAd2C678C8A3c282a9e17b   block 59428872
#   LockstepGuard   0xC41eCe384Ee559A30Ed350Ce26ba563B618A3510   block 59428911
#   MockBondAsset   0xF9D382a5A851dAe325526ec0Aa1a9773221c033A   block 59428803  (mAUSD, 6dp)
#
# The bond asset is a freely mintable mock, which is correct on a test chain and refused on mainnet
# by the deploy script: a registry whose bonds are worthless is worse than no registry.
PIN_REGISTRY=0xe784a386591cFcE683fAd2C678C8A3c282a9e17b

# The EOA delegated to LockstepGuard via EIP-7702. Its code is 0xef0100 || guard address.
ACCOUNT_ADDRESS=0x209C903f68f169C8e654e0C3C91cAdc4C4A4aFF2

# Where log scanning starts, and it is load-bearing rather than an optimisation.
#
# Monad's public RPC caps eth_getLogs at a 100 BLOCK RANGE and rate-limits concurrent range queries.
# Scanning from genesis is refused outright, so a reader that does not set this gets nothing and falls
# back to sample data. This is the block just before the first Published log.
DEPLOY_BLOCK=59431400

# Pin published in the live run: kuru-quote 2.1.0, two capabilities, one high risk, 1150 mAUSD bonded.
PIN_IDS=0x0573e8dd6c49cffb9c00dbf3eb224b0ee1abab6bae817b95f07d9a1273736401

# Publishes and bonds skills.
PUBLISHER_PRIVATE_KEY=
# Approves pins. Must derive exactly ACCOUNT_ADDRESS above, because approvals live in
# the account's own storage and the CLI refuses a mismatch rather than sending a
# transaction that cannot take effect.
ACCOUNT_PRIVATE_KEY=

# Read by the OpenClaw plugin. Separate from the account key on purpose: the executor
# spends gas, the account holds funds.
LOCKSTEP_EXECUTOR_KEY=


# =============================================================================
# 3. DEPLOY-TIME CONTRACT WIRING  — read by contracts/script/Deploy.s.sol
# =============================================================================
# All four are optional on testnet and fall back to safe values. BOND_ASSET stops
# being optional on mainnet.

# The ERC-20 posted as a publisher bond. On chain 143 the deploy script refuses to fall
# back to a mock, because a registry whose bonds are worthless is worse than no
# registry: it advertises a guarantee it cannot pay. Set the real AUSD address there.
BOND_ASSET=

# Receives slashed bonds. Defaults to the deployer.
SLASH_RECIPIENT=

# ERC-8004 registries, used by LockstepLens for the Sybil filter. Leaving these empty
# deploys the rest and disables the filter. Verify on the explorer before trusting an
# address from documentation.
ERC8004_IDENTITY=
ERC8004_REPUTATION=


# =============================================================================
# NOT SET HERE
# =============================================================================
# GitHub Actions reads INPUT_*, GITHUB_OUTPUT and GITHUB_STEP_SUMMARY. The runner
# provides those. For CI, set repository variables PIN_REGISTRY, CHAIN_ID and RPC_URL,
# and a repository secret PUBLISHER_PRIVATE_KEY.
